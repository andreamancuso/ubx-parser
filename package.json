{
  "name": "ubx-parser",
  "version": "0.1.2",
  "description": "Native Node.js addon for parsing u-blox UBX binary protocol (GNSS/GPS) messages",
  "main": "lib/index.js",
  "types": "types.d.ts",
  "license": "MPL-2.0",
  "author": "Andrea Mancuso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreamancuso/ubx-parser.git"
  },
  "bugs": {
    "url": "https://github.com/andreamancuso/ubx-parser/issues"
  },
  "homepage": "https://github.com/andreamancuso/ubx-parser#readme",
  "keywords": [
    "ubx",
    "ublox",
    "u-blox",
    "gps",
    "gnss",
    "parser",
    "napi",
    "native",
    "binary-protocol"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib/",
    "types.d.ts",
    "prebuilds/",
    "LICENSE"
  ],
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.6.0"
  },
  "scripts": {
    "build:prebuild:win32-x64": "cmake-js compile && node -e \"const fs=require('fs');fs.mkdirSync('prebuilds/win32-x64',{recursive:true});fs.copyFileSync('build/Release/ubx-parser.node','prebuilds/win32-x64/node.napi.node');\"",
    "build": "cmake-js compile",
    "rebuild": "cmake-js rebuild",
    "test": "node index.js",
    "generate-types": "node scripts/generate-types.js"
  }
}
